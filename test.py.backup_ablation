import os
import numpy as np
from PIL import Image
import torch
import torch.nn.functional as F
from skimage.metrics import peak_signal_noise_ratio as PSNR
from skimage.metrics import structural_similarity as SSIM
import csv
from models.LFTransMamba import LFTransMamba


# ============ CONFIG ============
angRes = 5
scale_factor = 4
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

SELECT = [2, 3, 4, 5, 6]

CHECKPOINT_PATH = "checkpoints/ablation_gaam.pth"
MODEL_NAME = "LFTransMamba_D16_R1_K4_C64_T3"

USE_TTA = True  # Test-Time Augmentation, +0.5~1 dB


# ============ MODEL ============
def build_model(model_name, angRes, scale):
    params = {}
    for part in model_name.split("_"):
        if part.startswith("D"):
            params["D"] = int(part[1:])
        elif part.startswith("R"):
            params["R"] = int(part[1:])
        elif part.startswith("K"):
            params["K"] = int(part[1:])
        elif part.startswith("C"):
            params["C"] = int(part[1:])
        elif part.startswith("T"):
            params["T"] = int(part[1:])
    return LFTransMamba(angRes_in=angRes, scale_factor=scale, **params)


# ============ TTA ============
def inference_tta(model, lr):
    """8-fold Test-Time Augmentation."""
    preds = []
    with torch.no_grad():
        preds.append(model(lr))
        preds.append(model(lr.rot90(1, [2, 3]).flip([2])).flip([2]).rot90(3, [2, 3]))
        preds.append(model(lr.flip([2])).flip([2]))
        preds.append(model(lr.rot90(3, [2, 3])).rot90(1, [2, 3]))
        preds.append(model(lr.rot90(2, [2, 3]).flip([2])).flip([2]).rot90(2, [2, 3]))
        preds.append(model(lr.rot90(1, [2, 3])).rot90(3, [2, 3]))
        preds.append(model(lr.rot90(2, [2, 3])).rot90(2, [2, 3]))
        preds.append(model(lr.rot90(3, [2, 3]).flip([2])).flip([2]).rot90(1, [2, 3]))
    return torch.stack(preds, dim=0).mean(dim=0)


# ============ UTIL ============
def rgb2ycbcr_y(img):
    img = img.astype(np.float32) / 255.0
    y = 65.481 * img[..., 0] + 128.553 * img[..., 1] + 24.966 * img[..., 2] + 16.0
    return np.clip(y / 255.0, 0.0, 1.0)


def load_lf(scene_path):
    imgs = sorted(f for f in os.listdir(scene_path)
                  if f.startswith("input_Cam") and f.endswith(".png"))
    views = []
    for f in imgs:
        views.append(np.array(Image.open(os.path.join(scene_path, f)).convert("RGB")))
    views = np.stack(views, 0)
    H, W = views.shape[1], views.shape[2]
    views = views.reshape(9, 9, H, W, 3)
    views = views[np.ix_(SELECT, SELECT)]
    u, v = 5, 5
    y_views = np.zeros((u, v, H, W), dtype=np.float32)
    for i in range(u):
        for j in range(v):
            y_views[i, j] = rgb2ycbcr_y(views[i, j])
    sai = y_views.transpose(0, 2, 1, 3).reshape(u * H, v * W)
    hr_sai = torch.from_numpy(sai).float().unsqueeze(0).unsqueeze(0)
    return hr_sai, H, W


def create_lr(hr_sai, scale):
    return F.interpolate(hr_sai, scale_factor=1.0 / scale,
                         mode="bicubic", align_corners=False)


def extract_center_view(sai, H, W, u=5, v=5):
    arr = sai.squeeze().cpu().numpy()
    ci, cj = u // 2, v // 2
    return arr[ci * H:(ci + 1) * H, cj * W:(cj + 1) * W]


# ============ MAIN ============
def main():
    model = build_model(MODEL_NAME, angRes, scale_factor).to(device)

    if os.path.exists(CHECKPOINT_PATH):
        state_dict = torch.load(CHECKPOINT_PATH, map_location="cpu")
        if "state_dict" in state_dict:
            state_dict = state_dict["state_dict"]
        clean = {k.replace("module.", ""): v for k, v in state_dict.items()}
        model.load_state_dict(clean, strict=False)
        print("Loaded checkpoint: " + CHECKPOINT_PATH)
    else:
        print("[WARNING] Checkpoint not found: " + CHECKPOINT_PATH)

    model.eval()

    test_root = "/root/autodl-tmp/ZJL/train_ready_all/test"
    scenes = sorted(s for s in os.listdir(test_root)
                    if os.path.isdir(os.path.join(test_root, s))
                    and not s.startswith("."))

    results = []
    print("Test scenes: " + str(len(scenes)))
    print("TTA: " + ("ON" if USE_TTA else "OFF"))

    for scene in scenes:
        try:
            scene_path = os.path.join(test_root, scene)
            hr_sai, H_view, W_view = load_lf(scene_path)
            hr_sai = hr_sai.to(device)
            lr = create_lr(hr_sai, scale_factor)

            if USE_TTA:
                sr = inference_tta(model, lr)
            else:
                with torch.no_grad():
                    sr = model(lr)

            sr_center = extract_center_view(sr, H_view, W_view)
            hr_center = extract_center_view(hr_sai, H_view, W_view)

            psnr_val = PSNR(hr_center, sr_center, data_range=1.0)
            ssim_val = SSIM(hr_center, sr_center, data_range=1.0)

            print("[%s] PSNR=%.3f  SSIM=%.4f" % (scene, psnr_val, ssim_val))
            results.append([scene, psnr_val, ssim_val])

        except Exception as e:
            import traceback
            print("[Skip %s] %s" % (scene, str(e)))
            traceback.print_exc()

    os.makedirs("results", exist_ok=True)
    with open("results/test_results.csv", "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["scene", "PSNR", "SSIM"])
        writer.writerows(results)

    if results:
        psnrs = [r[1] for r in results]
        ssims = [r[2] for r in results]
        print("\n===== FINAL RESULT =====")
        print("AVG PSNR: %.4f" % np.mean(psnrs))
        print("AVG SSIM: %.4f" % np.mean(ssims))
    else:
        print("No valid results!")


if __name__ == "__main__":
    main()
